.mx_GifPicker {
    width: 320px;
    height: 400px;
    display: flex;
    flex-direction: column;
    background-color: $menu-bg-color;
    border-radius: 8px;
    overflow: hidden;
}

.mx_GifPicker_search {
    width: 100%;
    padding: 8px 12px;
    border: none;
    border-bottom: 1px solid $input-border-color;
    background: transparent;
    color: $primary-content;
    font-size: 14px;
    outline: none;
    box-sizing: border-box;

    &::placeholder {
        color: $secondary-content;
    }
}

.mx_GifPicker_loading,
.mx_GifPicker_nokey {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    color: $secondary-content;
    font-size: 14px;
    padding: 16px;
    text-align: center;
}

.mx_GifPicker_grid {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
    overflow-y: auto;
    padding: 4px;
}

.mx_GifPicker_gif {
    cursor: pointer;
    position: relative;
    overflow: hidden;
    border-radius: 4px;

    img {
        width: 100%;
        aspect-ratio: 1;
        object-fit: cover;
        display: block;
        transition: opacity 0.15s ease;
    }

    &:hover img {
        opacity: 0.8;
    }
}

.mx_GifButton_label {
    font-size: 14px;
    font-weight: bold;
    color: inherit;
}
