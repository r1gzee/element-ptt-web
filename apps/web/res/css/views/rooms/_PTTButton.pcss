.mx_PTTButton {
    /* Unset AccessibleButton defaults */
    border: none;
    cursor: pointer;
    user-select: none;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--cpd-space-2x);

    width: 80px;
    height: 80px;
    border-radius: 50%;
    padding: 0;
    transition:
        background-color 0.15s ease,
        transform 0.1s ease,
        box-shadow 0.15s ease;

    svg {
        width: 28px;
        height: 28px;
        flex-shrink: 0;
    }
}

/* Label below the icon — shown outside the circle */
.mx_PTTButton_label {
    display: block;
    font: var(--cpd-font-body-xs-regular);
    color: $secondary-content;
    margin-top: var(--cpd-space-2x);
    /* Labels sit outside the circle, so remove from button layout */
    position: absolute;
    bottom: -24px;
    white-space: nowrap;
}

/* Wrapper so the label has space below the button */
.mx_PTTButton {
    position: relative;
    margin-bottom: 28px;
}

/* ── States ─────────────────────────────────────────────────────── */

/* inactive: not in a voice channel */
.mx_PTTButton_inactive {
    background-color: var(--cpd-color-bg-subtle-secondary);
    color: var(--cpd-color-icon-disabled);
    cursor: not-allowed;
}

/* ready: floor is free, press to speak */
.mx_PTTButton_ready {
    background-color: var(--cpd-color-bg-success-subtle);
    color: var(--cpd-color-text-success-primary);
    box-shadow: 0 0 0 0 var(--cpd-color-text-success-primary);
    animation: mx_PTTButton_pulse 2s infinite;

    &:hover {
        background-color: var(--cpd-color-bg-action-primary-hovered);
        color: var(--cpd-color-icon-on-solid-primary);
        animation: none;
        transform: scale(1.04);
    }

    &:active {
        transform: scale(0.96);
    }
}

/* speaking: local user is holding the floor */
.mx_PTTButton_speaking {
    background-color: var(--cpd-color-bg-critical-primary);
    color: var(--cpd-color-icon-on-solid-primary);
    animation: none;
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--cpd-color-bg-critical-primary) 30%, transparent);
    transform: scale(1.08);

    .mx_PTTButton_label {
        color: var(--cpd-color-text-critical-primary);
    }
}

/* blocked: another participant is speaking */
.mx_PTTButton_blocked {
    background-color: var(--cpd-color-bg-subtle-secondary);
    color: var(--cpd-color-icon-disabled);
    cursor: not-allowed;
    opacity: 0.6;
    animation: none;
}

/* ── Pulse animation for the ready state ─────────────────────────── */

@keyframes mx_PTTButton_pulse {
    0% {
        box-shadow: 0 0 0 0 color-mix(in srgb, var(--cpd-color-text-success-primary) 40%, transparent);
    }
    70% {
        box-shadow: 0 0 0 10px color-mix(in srgb, var(--cpd-color-text-success-primary) 0%, transparent);
    }
    100% {
        box-shadow: 0 0 0 0 color-mix(in srgb, var(--cpd-color-text-success-primary) 0%, transparent);
    }
}
