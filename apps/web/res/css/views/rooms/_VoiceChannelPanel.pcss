.mx_VoiceChannelPanel {
    display: flex;
    flex-direction: column;
    border-top: 1px solid $separator;
    background-color: $background;
    padding: var(--cpd-space-2x) var(--cpd-space-4x);
    gap: var(--cpd-space-2x);
    flex-shrink: 0;
}

.mx_VoiceChannelPanel_header {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-3x);
    min-height: 32px;
    flex-wrap: wrap;
}

.mx_VoiceChannelPanel_title {
    color: var(--cpd-color-text-action-accent);
    flex: 1;
    display: flex;
    align-items: center;
    gap: var(--cpd-space-1-5x);

    /* Small microphone pulse indicator shown when anyone is in the channel */
    &::before {
        content: "";
        display: inline-block;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background-color: var(--cpd-color-text-action-accent);
        flex-shrink: 0;
    }
}

.mx_VoiceChannelPanel_participants {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-1-5x);
    color: $secondary-content;
}

.mx_VoiceChannelPanel_controls {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-2x);
}

/* ── Inline mic button + label ─────────────────────────────────── */

.mx_VoiceChannelPanel_micWrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--cpd-space-1x);
}

.mx_VoiceChannelPanel_micLabel {
    color: $secondary-content;
    white-space: nowrap;
}

.mx_VoiceChannelPanel_micButton {
    &.mx_VoiceChannelPanel_micButton_active {
        background-color: var(--cpd-color-bg-action-primary-rest);
        color: var(--cpd-color-icon-on-solid-primary);

        &:hover {
            background-color: var(--cpd-color-bg-action-primary-hovered);
        }
    }

    &.mx_VoiceChannelPanel_micButton_blocked {
        opacity: 0.4;
        cursor: not-allowed;
    }
}

/* ── Body (below header) ──────────────────────────────────────────── */

.mx_VoiceChannelPanel_body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--cpd-space-3x);
    padding: var(--cpd-space-2x) 0;
}

/* ── Mute toggle (Live Audio mode) ─────────────────────────────── */

.mx_VoiceChannelPanel_muteButton {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: var(--cpd-color-bg-action-primary-rest);
    color: var(--cpd-color-icon-on-solid-primary);

    svg {
        width: 20px;
        height: 20px;
    }

    &:hover {
        background-color: var(--cpd-color-bg-action-primary-hovered);
    }

    &:active {
        background-color: var(--cpd-color-bg-action-primary-pressed);
    }

    &.mx_VoiceChannelPanel_muteButton_muted {
        background-color: var(--cpd-color-bg-subtle-secondary);
        color: $secondary-content;

        &:hover {
            background-color: var(--cpd-color-bg-subtle-primary);
            color: $primary-content;
        }
    }
}

/* ── Collapsed state ─────────────────────────────────────────────── */

.mx_VoiceChannelPanel_collapsed {
    .mx_VoiceChannelPanel_body {
        display: none;
    }
}
